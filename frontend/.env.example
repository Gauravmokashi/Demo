# Where Next.js proxies /api requests (the NestJS API origin, without /api).
API_PROXY_TARGET="http://localhost:4000"
# Optional: call the API directly from the browser instead of through the proxy.
# Only works when the API shares the frontend's site, because the session cookie is SameSite=Strict.
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"
